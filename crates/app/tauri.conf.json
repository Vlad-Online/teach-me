{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "teach-me",
  "version": "0.1.0",
  "identifier": "local.teachme.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
