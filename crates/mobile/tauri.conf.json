{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "teach-me",
  "version": "0.1.0",
  "identifier": "local.teachme.mobile",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "teach-me" }],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
